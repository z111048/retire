[
  { "start": 12.0, "end": 19.0, "text": "有一種溫柔，叫做每天準時到來" },
  { "start": 21.0, "end": 28.0, "text": "有一種踏實，叫做從不缺席的妳" },

  { "start": 29.0, "end": 34.5, "text": "那些開不完的會、簽不完的文件" },
  { "start": 36.0, "end": 42.0, "text": "妳都用笑容，一一撐了過來" },
  { "start": 43.5, "end": 49.5, "text": "高雄的城市在妳手裡慢慢長大" },
  { "start": 50.5, "end": 56.0, "text": "沒有人知道，妳付出了多少個日與夜" },

  { "start": 57.0, "end": 62.5, "text": "加班的燈光下，有妳的身影" },
  { "start": 63.5, "end": 69.0, "text": "吵架又和好，是我們最熟悉的默契" },
  { "start": 70.0, "end": 75.5, "text": "原來努力這件事，因為有人陪" },
  { "start": 76.5, "end": 81.0, "text": "就不再那麼難了" },

  { "start": 82.0, "end": 88.5, "text": "今天妳走出這扇門" },
  { "start": 89.5, "end": 96.0, "text": "帶走的不只是退休金" },
  { "start": 97.0, "end": 103.5, "text": "還有我們每一個人" },
  { "start": 104.5, "end": 110.0, "text": "最真心的感謝" },

  { "start": 111.0, "end": 117.0, "text": "秀燕，謝謝妳" },
  { "start": 118.5, "end": 127.0, "text": "謝謝妳讓這個地方，因為有妳而不一樣" },
  { "start": 128.0, "end": 134.5, "text": "往後的日子，請好好為自己而活" },
  { "start": 135.5, "end": 140.0, "text": "退休快樂" }
]
