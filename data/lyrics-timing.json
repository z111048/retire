[
  {
    "start": 11.61,
    "end": 15.61,
    "text": "秀燕姐 退休快樂"
  },
  {
    "start": 16.75,
    "end": 20.75,
    "text": "都發局花 永遠美麗綻放"
  },
  {
    "start": 24.84,
    "end": 27.92,
    "text": "親愛的秀燕姐"
  },
  {
    "start": 28.07,
    "end": 30.8,
    "text": "轉眼走過好多年"
  },
  {
    "start": 30.95,
    "end": 33.27,
    "text": "四十七年的青春"
  },
  {
    "start": 33.42,
    "end": 37.4,
    "text": "寫成最溫暖的奉獻"
  },
  {
    "start": 37.55,
    "end": 39.55,
    "text": "在都發局的每一天"
  },
  {
    "start": 39.7,
    "end": 42.53,
    "text": "有妳就有笑聲蔓延"
  },
  {
    "start": 42.68,
    "end": 44.42,
    "text": "尾牙舞台一站上去"
  },
  {
    "start": 44.57,
    "end": 47.43,
    "text": "大家都跟著妳發光發電"
  },
  {
    "start": 47.58,
    "end": 51.6,
    "text": "妳的認真 妳的真誠"
  },
  {
    "start": 52,
    "end": 56.8,
    "text": "妳把溫暖送給身邊的人"
  },
  {
    "start": 58.83,
    "end": 62.83,
    "text": "妳的善良 妳的熱情"
  },
  {
    "start": 64.68,
    "end": 68.68,
    "text": "是我們心中最美的風景"
  },
  {
    "start": 73.15,
    "end": 75.92,
    "text": "秀出精彩每一天"
  },
  {
    "start": 76.07,
    "end": 78.66,
    "text": "燕語歡聲伴流年"
  },
  {
    "start": 78.81,
    "end": 81.56,
    "text": "美好人生新啟程"
  },
  {
    "start": 81.71,
    "end": 84.12,
    "text": "女神自在樂悠然"
  },
  {
    "start": 84.27,
    "end": 87.5,
    "text": "不是告別 是新的開始"
  },
  {
    "start": 87.65,
    "end": 90.24,
    "text": "把忙碌的時間還給自己"
  },
  {
    "start": 90.39,
    "end": 92.44,
    "text": "去旅行 去微笑 去擁抱"
  },
  {
    "start": 92.59,
    "end": 96.59,
    "text": "過每一個妳喜歡的日子"
  },
  {
    "start": 101.36,
    "end": 104.54,
    "text": "總是自帶舞台效果"
  },
  {
    "start": 104.69,
    "end": 106.99,
    "text": "帶來歡笑的妳"
  },
  {
    "start": 107.14,
    "end": 109.42,
    "text": "竟然也要退休了"
  },
  {
    "start": 109.57,
    "end": 113.57,
    "text": "真的好捨不得妳"
  },
  {
    "start": 113.78,
    "end": 115.96,
    "text": "想起當年被妳拐去"
  },
  {
    "start": 116.11,
    "end": 118.64,
    "text": "尾牙一起表演回憶"
  },
  {
    "start": 118.79,
    "end": 120.7,
    "text": "嘴上說是被妳騙去"
  },
  {
    "start": 120.85,
    "end": 123.99,
    "text": "心裡卻感謝有妳"
  },
  {
    "start": 124.14,
    "end": 128.14,
    "text": "那些迎新送舊的日子"
  },
  {
    "start": 129.34,
    "end": 133.34,
    "text": "那些笑到流淚的故事"
  },
  {
    "start": 135.3,
    "end": 139.3,
    "text": "因為妳變得珍貴"
  },
  {
    "start": 140.65,
    "end": 144.65,
    "text": "因為妳變得難忘美麗"
  },
  {
    "start": 149.67,
    "end": 152.2,
    "text": "秀出精彩每一天"
  },
  {
    "start": 152.35,
    "end": 154.97,
    "text": "燕語歡聲伴流年"
  },
  {
    "start": 155.12,
    "end": 157.88,
    "text": "美好人生新啟程"
  },
  {
    "start": 158.03,
    "end": 160.51,
    "text": "女神自在樂悠然"
  },
  {
    "start": 160.66,
    "end": 163.7,
    "text": "不是告別 是新的開始"
  },
  {
    "start": 163.85,
    "end": 166.58,
    "text": "把忙碌的時間還給自己"
  },
  {
    "start": 166.73,
    "end": 169.45,
    "text": "去旅行 去微笑 去擁抱"
  },
  {
    "start": 169.6,
    "end": 173.01,
    "text": "過每一個妳喜歡的日子"
  },
  {
    "start": 173.16,
    "end": 175.2,
    "text": "親愛可愛活潑的秀燕姐"
  },
  {
    "start": 175.35,
    "end": 177.94,
    "text": "退休也要像影后般耀眼"
  },
  {
    "start": 178.09,
    "end": 180.7,
    "text": "拿下人生的終身成就獎"
  },
  {
    "start": 180.85,
    "end": 183.67,
    "text": "第二人生比舞台還精彩"
  },
  {
    "start": 183.82,
    "end": 186.39,
    "text": "當個快樂的包租女王"
  },
  {
    "start": 186.54,
    "end": 189.19,
    "text": "天天唱歌 天天開心"
  },
  {
    "start": 189.34,
    "end": 191.92,
    "text": "幸福快樂每一天"
  },
  {
    "start": 192.07,
    "end": 196.07,
    "text": "愛妳的人都在這裡"
  },
  {
    "start": 197.16,
    "end": 200.46,
    "text": "總是笑咪咪的秀燕姐"
  },
  {
    "start": 200.61,
    "end": 203.32,
    "text": "數饅頭的日子終於結束了"
  },
  {
    "start": 203.47,
    "end": 205.77,
    "text": "豪爽又真誠的個性"
  },
  {
    "start": 205.92,
    "end": 208.99,
    "text": "幽默玩笑最讓人記得"
  },
  {
    "start": 209.14,
    "end": 211.74,
    "text": "沒有妳的都發局"
  },
  {
    "start": 211.89,
    "end": 214.57,
    "text": "怎麼可以叫都發局"
  },
  {
    "start": 214.72,
    "end": 217.38,
    "text": "想到以後少了妳身影"
  },
  {
    "start": 217.53,
    "end": 221.53,
    "text": "我們心裡真的捨不得妳"
  },
  {
    "start": 222.93,
    "end": 225.54,
    "text": "秀出精彩每一天"
  },
  {
    "start": 225.69,
    "end": 228.37,
    "text": "燕語歡聲伴流年"
  },
  {
    "start": 228.52,
    "end": 231.25,
    "text": "美好人生新啟程"
  },
  {
    "start": 231.4,
    "end": 234.03,
    "text": "女神自在樂悠然"
  },
  {
    "start": 234.18,
    "end": 237.04,
    "text": "繼續精彩 繼續美美"
  },
  {
    "start": 237.19,
    "end": 240.1,
    "text": "繼續把日子過得動人"
  },
  {
    "start": 240.25,
    "end": 242.33,
    "text": "不管未來在哪裡"
  },
  {
    "start": 242.48,
    "end": 245.46,
    "text": "妳都會美艷又閃耀動人"
  },
  {
    "start": 245.61,
    "end": 249.61,
    "text": "當然退休後別太忙著享福"
  },
  {
    "start": 252.81,
    "end": 256.57,
    "text": "還要記得回來看看我們"
  },
  {
    "start": 256.72,
    "end": 260.72,
    "text": "都發局花 永遠綻放"
  },
  {
    "start": 262.33,
    "end": 266.33,
    "text": "秀燕姐 祝妳退休快樂"
  },
  {
    "start": 272.19,
    "end": 276.19,
    "text": "退休快樂"
  },
  {
    "start": 282.32,
    "end": 286.32,
    "text": "幸福滿滿"
  },
  {
    "start": 287.84,
    "end": 291.84,
    "text": "第二人生"
  },
  {
    "start": 292.27,
    "end": 296.27,
    "text": "比夢還精彩"
  }
]