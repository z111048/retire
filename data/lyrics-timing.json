[
  { "start": 30.6,  "end": 38.7,  "text": "有一種溫柔，叫做每天準時到來" },
  { "start": 44.9,  "end": 51.9,  "text": "有一種踏實，叫做從不缺席的妳" },
  { "start": 57.4,  "end": 63.9,  "text": "那些開不完的會、簽不完的文件" },
  { "start": 65.2,  "end": 69.9,  "text": "妳都用笑容，一一撐了過來" },
  { "start": 72.5,  "end": 77.4,  "text": "高雄的城市在妳手裡慢慢長大" },
  { "start": 77.9,  "end": 85.4,  "text": "沒有人知道，妳付出了多少個日與夜" },
  { "start": 89.4,  "end": 92.7,  "text": "今天妳走出這扇門" },
  { "start": 92.9,  "end": 96.4,  "text": "帶走的不只是退休金" },
  { "start": 96.9,  "end": 99.9,  "text": "還有我們每一個人" },
  { "start": 99.9,  "end": 102.9, "text": "最真心的感謝" },
  { "start": 103.9, "end": 105.9, "text": "秀燕，謝謝妳" },
  { "start": 105.9, "end": 114.9, "text": "謝謝妳讓這個地方，因為有妳而不一樣" },
  { "start": 117.4, "end": 124.9, "text": "往後的日子，請好好為自己而活" },
  { "start": 126.9, "end": 129.4, "text": "退休快樂" }
]
