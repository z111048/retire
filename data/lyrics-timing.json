[
  {
    "start": 11.31,
    "end": 16.73,
    "text": "秀燕姐 退休快樂"
  },
  {
    "start": 16.76,
    "end": 22.95,
    "text": "都發局花 永遠美麗綻放"
  },
  {
    "start": 24.51,
    "end": 27.83,
    "text": "親愛的秀燕姐"
  },
  {
    "start": 27.86,
    "end": 30.8,
    "text": "轉眼走過好多年"
  },
  {
    "start": 30.82,
    "end": 33.05,
    "text": "四十七年的青春"
  },
  {
    "start": 33.08,
    "end": 37.07,
    "text": "寫成最溫暖的奉獻"
  },
  {
    "start": 37.09,
    "end": 39.55,
    "text": "在都發局的每一天"
  },
  {
    "start": 39.58,
    "end": 42.35,
    "text": "有妳就有笑聲蔓延"
  },
  {
    "start": 42.38,
    "end": 44.38,
    "text": "尾牙舞台一站上去"
  },
  {
    "start": 44.4,
    "end": 47.43,
    "text": "大家都跟著妳發光發電"
  },
  {
    "start": 47.45,
    "end": 52.37,
    "text": "妳的認真 妳的真誠"
  },
  {
    "start": 52.4,
    "end": 58.8,
    "text": "妳把溫暖送給身邊的人"
  },
  {
    "start": 58.83,
    "end": 64.5,
    "text": "妳的善良 妳的熱情"
  },
  {
    "start": 64.53,
    "end": 73.02,
    "text": "是我們心中最美的風景"
  },
  {
    "start": 73.04,
    "end": 75.92,
    "text": "秀出精彩每一天"
  },
  {
    "start": 75.94,
    "end": 78.66,
    "text": "燕語歡聲伴流年"
  },
  {
    "start": 78.69,
    "end": 81.69,
    "text": "美好人生新啟程"
  },
  {
    "start": 81.71,
    "end": 84.25,
    "text": "女神自在樂悠然"
  },
  {
    "start": 84.27,
    "end": 87.5,
    "text": "不是告別 是新的開始"
  },
  {
    "start": 87.53,
    "end": 90.24,
    "text": "把忙碌的時間還給自己"
  },
  {
    "start": 90.27,
    "end": 92.43,
    "text": "去旅行 去微笑 去擁抱"
  },
  {
    "start": 92.45,
    "end": 96.59,
    "text": "過每一個妳喜歡的日子"
  },
  {
    "start": 101.18,
    "end": 104.36,
    "text": "總是自帶舞台效果"
  },
  {
    "start": 104.6,
    "end": 106.99,
    "text": "帶來歡笑的妳"
  },
  {
    "start": 107.02,
    "end": 109.55,
    "text": "竟然也要退休了"
  },
  {
    "start": 109.57,
    "end": 113.75,
    "text": "真的好捨不得妳"
  },
  {
    "start": 113.78,
    "end": 115.89,
    "text": "想起當年被妳拐去"
  },
  {
    "start": 115.91,
    "end": 118.64,
    "text": "尾牙一起表演回憶"
  },
  {
    "start": 118.67,
    "end": 120.66,
    "text": "嘴上說是被妳騙去"
  },
  {
    "start": 120.68,
    "end": 123.79,
    "text": "心裡卻感謝有妳"
  },
  {
    "start": 123.81,
    "end": 129.31,
    "text": "那些迎新送舊的日子"
  },
  {
    "start": 129.34,
    "end": 135.01,
    "text": "那些笑到流淚的故事"
  },
  {
    "start": 135.03,
    "end": 140.52,
    "text": "因為妳變得珍貴"
  },
  {
    "start": 140.54,
    "end": 149.47,
    "text": "因為妳變得難忘美麗"
  },
  {
    "start": 149.5,
    "end": 152.09,
    "text": "秀出精彩每一天"
  },
  {
    "start": 152.11,
    "end": 154.87,
    "text": "燕語歡聲伴流年"
  },
  {
    "start": 154.89,
    "end": 157.8,
    "text": "美好人生新啟程"
  },
  {
    "start": 157.83,
    "end": 160.37,
    "text": "女神自在樂悠然"
  },
  {
    "start": 160.4,
    "end": 163.75,
    "text": "不是告別 是新的開始"
  },
  {
    "start": 163.77,
    "end": 166.71,
    "text": "把忙碌的時間還給自己"
  },
  {
    "start": 166.73,
    "end": 168.97,
    "text": "去旅行 去微笑 去擁抱"
  },
  {
    "start": 169.0,
    "end": 172.79,
    "text": "過每一個妳喜歡的日子"
  },
  {
    "start": 173.0,
    "end": 175.12,
    "text": "親愛可愛活潑的秀燕姐"
  },
  {
    "start": 175.14,
    "end": 177.89,
    "text": "退休也要像影后般耀眼"
  },
  {
    "start": 177.91,
    "end": 180.61,
    "text": "拿下人生的終身成就獎"
  },
  {
    "start": 180.63,
    "end": 183.69,
    "text": "第二人生比舞台還精彩"
  },
  {
    "start": 183.71,
    "end": 186.51,
    "text": "當個快樂的包租女王"
  },
  {
    "start": 186.54,
    "end": 189.31,
    "text": "天天唱歌 天天開心"
  },
  {
    "start": 189.34,
    "end": 192.05,
    "text": "幸福快樂每一天"
  },
  {
    "start": 192.07,
    "end": 197.13,
    "text": "愛妳的人都在這裡"
  },
  {
    "start": 197.16,
    "end": 200.59,
    "text": "總是笑咪咪的秀燕姐"
  },
  {
    "start": 200.61,
    "end": 203.44,
    "text": "數饅頭的日子終於結束了"
  },
  {
    "start": 203.47,
    "end": 206.08,
    "text": "豪爽又真誠的個性"
  },
  {
    "start": 206.1,
    "end": 208.99,
    "text": "幽默玩笑最讓人記得"
  },
  {
    "start": 209.01,
    "end": 211.87,
    "text": "沒有妳的都發局"
  },
  {
    "start": 211.89,
    "end": 214.57,
    "text": "怎麼可以叫都發局"
  },
  {
    "start": 214.59,
    "end": 217.5,
    "text": "想到以後少了妳身影"
  },
  {
    "start": 217.53,
    "end": 222.74,
    "text": "我們心裡真的捨不得妳"
  },
  {
    "start": 222.77,
    "end": 225.56,
    "text": "秀出精彩每一天"
  },
  {
    "start": 225.58,
    "end": 228.5,
    "text": "燕語歡聲伴流年"
  },
  {
    "start": 228.53,
    "end": 231.26,
    "text": "美好人生新啟程"
  },
  {
    "start": 231.29,
    "end": 234.03,
    "text": "女神自在樂悠然"
  },
  {
    "start": 234.05,
    "end": 236.94,
    "text": "繼續精彩 繼續美美"
  },
  {
    "start": 236.96,
    "end": 240.03,
    "text": "繼續把日子過得動人"
  },
  {
    "start": 240.05,
    "end": 242.13,
    "text": "不管未來在哪裡"
  },
  {
    "start": 242.16,
    "end": 245.42,
    "text": "妳都會美艷又閃耀動人"
  },
  {
    "start": 245.44,
    "end": 251.71,
    "text": "當然退休後別太忙著享福"
  },
  {
    "start": 251.74,
    "end": 256.46,
    "text": "還要記得回來看看我們"
  },
  {
    "start": 256.49,
    "end": 261.96,
    "text": "都發局花 永遠綻放"
  },
  {
    "start": 261.99,
    "end": 276.21,
    "text": "秀燕姐 祝妳退休快樂"
  },
  {
    "start": 276.23,
    "end": 277.62,
    "text": "退休快樂"
  },
  {
    "start": 281.62,
    "end": 286.78,
    "text": "幸福滿滿"
  },
  {
    "start": 287.19,
    "end": 291.19,
    "text": "第二人生"
  },
  {
    "start": 291.95,
    "end": 295.59,
    "text": "比夢還精彩"
  }
]