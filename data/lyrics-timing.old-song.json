[
  { "start": 13.5, "end": 20.0, "text": "有一種溫柔，叫做每天準時到來" },
  { "start": 21.0, "end": 27.5, "text": "有一種踏實，叫做從不缺席的妳" },

  { "start": 30.5, "end": 37.0, "text": "那些開不完的會、簽不完的文件" },
  { "start": 37.5, "end": 42.0, "text": "妳都用笑容，一一撐了過來" },
  { "start": 42.5, "end": 48.0, "text": "高雄的城市在妳手裡慢慢長大" },
  { "start": 48.5, "end": 55.5, "text": "沒有人知道，妳付出了多少個日與夜" },

  { "start": 58.5, "end": 64.0, "text": "加班的燈光下，有妳的身影" },
  { "start": 64.5, "end": 71.0, "text": "吵架又和好，是我們最熟悉的默契" },
  { "start": 71.5, "end": 77.0, "text": "原來努力這件事，因為有人陪" },
  { "start": 77.5, "end": 80.5, "text": "就不再那麼難了" },

  { "start": 83.5, "end": 90.5, "text": "今天妳走出這扇門" },
  { "start": 91.0, "end": 98.0, "text": "帶走的不只是退休金" },
  { "start": 98.5, "end": 104.5, "text": "還有我們每一個人" },
  { "start": 105.0, "end": 109.5, "text": "最真心的感謝" },

  { "start": 112.5, "end": 117.5, "text": "秀燕，謝謝妳" },
  { "start": 118.0, "end": 126.5, "text": "謝謝妳讓這個地方，因為有妳而不一樣" },
  { "start": 127.0, "end": 134.0, "text": "往後的日子，請好好為自己而活" },
  { "start": 134.5, "end": 139.5, "text": "退休快樂" }
]
